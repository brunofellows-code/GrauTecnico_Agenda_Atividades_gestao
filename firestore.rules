rules_version = '2';

// ============================================================
// Sistema A - Grau Tecnico FSA - Regras do Firestore
// Fase 1 (base) + Bloco 2 (ocorrencias, solicitacoes) + F1-D
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function meRef() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function meExists() {
      return signedIn() && exists(meRef());
    }

    function me() {
      return get(meRef()).data;
    }

    function isActive() {
      return meExists() && me().ativo == true;
    }

    function perfil() {
      return me().perfil;
    }

    // Transicao 4->3 perfis (lockout-safe): aceita legado 'Admin' e o novo 'gestor'.
    function isAdmin() {
      return isActive() && (perfil() == 'Admin' || perfil() == 'gestor');
    }

    // Transicao 4->3 perfis: legados 'Admin'/'Editor' e novos 'gestor'/'lider'.
    function canWrite() {
      return isActive() && (perfil() == 'Admin' || perfil() == 'Editor'
                            || perfil() == 'gestor' || perfil() == 'lider');
    }

    // F1-D: o lider precisa LISTAR usuarios para atribuir responsavel aos
    // liderados. O recorte fino (somente o escopo dele) e aplicado no cliente
    // via KPI.usuariosNoEscopo. Esta regra da o piso: nome/perfil/setor de
    // usuarios ativos, nada alem do que a sidebar ja mostra.
    function isLider() {
      return isActive() && (perfil() == 'lider' || perfil() == 'Editor');
    }

    function donoAtividade(aid) {
      return signedIn()
          && exists(/databases/$(database)/documents/atividades/$(aid))
          && get(/databases/$(database)/documents/atividades/$(aid)).data.criadoPor == request.auth.uid;
    }

    // ---------- usuarios (RBAC) ----------
    // F1-D: 'list' liberado para gestor E lider (o lider atribui no escopo).
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin() || isLider();
      allow write: if isAdmin();
    }

    // ---------- setores ----------
    match /setores/{sigla} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- projetos (LEGADO — R4-B2) ----------
    // "Projeto" nao existe mais: nenhuma tela escreve aqui. A leitura
    // fica SO para o admin, porque o backup do gestor (importacao.html,
    // BK_COLS) percorre a colecao em cadeia sem catch por colecao —
    // negar a leitura derrubaria o backup inteiro. Escrita: morta.
    match /projetos/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- planejamentos (R4-B3: 5W2H mensal do lider) ----------
    // 1 doc por setor+competencia. Leitura ABERTA a todo ativo
    // (prestacao de contas publica — RESUMO §4). Escrita = canWrite;
    // a alcada R$200 (item >R$200 exige aprovLider E aprovGestor) e a
    // autoria da assinatura sao aplicadas no cliente e auditadas no
    // atividade_log — granularidade por item de array nao e modelavel
    // nas rules sem explodir o doc (registrado no HANDOFF R4).
    match /planejamentos/{id} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update: if canWrite();
      allow delete: if false; // soft-delete sempre (ativo:false)
    }

    // ---------- atividades ----------
    // R5-B1: ACEITE DE ATRIBUICAO (padrao Outlook Accept/Decline em tarefa
    // atribuida): o RESPONSAVEL — mesmo perfil 'usuario' — registra aceite ou
    // recusa na PROPRIA atividade. Espelha o F1-J das ocorrencias: o vinculo
    // e verificado no doc atual (resource), e o diff trava tudo alem dos
    // campos do aceite. Delete explicito negado (soft-delete sempre; nenhuma
    // tela chama deleteDoc — verificado no repo em 22/07).
    match /atividades/{id} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update: if canWrite()
        || (isActive()
            && resource.data.responsavelUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aceite', 'recusaAtribuicao', 'atualizadoEm']));
      allow delete: if false;
    }

    // ---------- ocorrencias ----------
    match /ocorrencias/{id} {
      allow read: if isActive();
      // F1-J: o RESPONSÁVEL age nas PRÓPRIAS ocorrências (padrão Asana:
      // quem é assignado numa tarefa pode concluí-la mesmo sendo
      // comment-only no resto). Só status de EXECUÇÃO — reprogramar e
      // pular continuam exigindo líder/gestor. O vínculo é verificado na
      // ATIVIDADE-mãe (1 get), não no que o cliente declara.
      allow create: if canWrite()
        || (isActive()
            && get(/databases/$(database)/documents/atividades/$(request.resource.data.atividadeId)).data.responsavelUid == request.auth.uid
            && request.resource.data.status in ['concluida', 'pendente', 'em_andamento']);
      allow update: if canWrite()
        || (isActive()
            && get(/databases/$(database)/documents/atividades/$(request.resource.data.atividadeId)).data.responsavelUid == request.auth.uid
            && request.resource.data.status in ['concluida', 'pendente', 'em_andamento']
            // edge da reatribuição: a base denormalizada (responsavelUid/
            // setorSigla) pode ressincronizar com a atividade-mãe — mas SÓ
            // para os valores atuais dela (nunca valores livres). data/
            // prazoOriginal/atividadeId ficam FORA: são amarrados ao id do
            // doc e mudar 'data' moveria o effDate (fraude de prazo).
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'concluidaEm', 'iniciadaEm', 'responsavelUid', 'setorSigla'])
            && request.resource.data.responsavelUid == request.auth.uid
            && request.resource.data.setorSigla == get(/databases/$(database)/documents/atividades/$(request.resource.data.atividadeId)).data.setorSigla);
      allow delete: if false;
    }

    // ---------- solicitacoes ----------
    match /solicitacoes/{id} {
      allow read: if isActive();
      allow create: if canWrite()
                    && request.resource.data.solicitanteUid == request.auth.uid
                    && request.resource.data.status == 'pendente';
      allow update: if isAdmin() || donoAtividade(resource.data.atividadeId);
      allow delete: if false;
    }

    // ---------- atividade_log (append-only) ----------
    // F1-G: create aberto a QUALQUER usuario ativo. O perfil 'usuario' agora
    // grava item de pauta (D2) e a mutacao dele tambem precisa ser logada —
    // append-only + update/delete negados: abrir o create e MAIS auditoria.
    match /atividade_log/{id} {
      allow read: if isActive();
      // RAIO-X: o uid gravado TEM de ser o do autor autenticado — impede
      // forjar autoria (o ranking da Performance nasce deste log).
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- reunioes ----------
    // F1-G (D2): participante (perfil 'usuario') pode mexer SO em pautaItens
    // (padrao Fellow: qualquer participante adiciona talking point). O diff
    // de chaves garante que nada alem da pauta e tocavel sem canWrite.
    // R5-B1: caminho RSVP do convocado — confirmadosUids (confirmar em 1
    // toque, F1-N) e recusas (avisar que nao vem, com motivo). O codigo do
    // Hoje ja gravava confirmadosUids desde a F1-N, mas a regra nunca subiu:
    // perfil 'usuario' tomava permission-denied. Mexer so no PROPRIO uid e
    // aplicado no cliente e auditado no atividade_log (anti-spoof uid==auth);
    // granularidade por chave de mapa nao e modelavel aqui sem explodir o doc
    // (mesma doutrina da alcada do planejamento, HANDOFF R4).
    match /reunioes/{id} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update: if canWrite()
                    || (isActive()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pautaItens', 'atualizadoEm']))
                    || (isActive()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmadosUids', 'recusas']));
      allow delete: if false;
    }

    // ---------- pauta_sugestoes (F1-F: cascata de pauta entre reunioes) ----------
    // Sugestao encaminhada de uma reuniao para a pauta de outra (tipo/setor).
    // Soft-delete via status 'descartada' (nunca delete fisico).
    // F1-G (D2): CREATE aberto a qualquer usuario ativo (todo participante
    // sugere pauta — padrao Fellow/Parabol). Moderacao (aceitar/descartar =
    // update) continua lider+.
    match /pauta_sugestoes/{id} {
      allow read: if isActive();
      allow create: if isActive();
      allow update: if canWrite();
      allow delete: if false;
    }

    // ---------- planos_acao (F1-G: plano vivo da Inteligencia) ----------
    // Plano nasce do gargalo/banda (ACAO OBRIGATORIA), tem dono, prazo e
    // atividadeIds[] (a execucao vive nas atividades — 1 motor). Status e
    // progresso sao SEMPRE derivados no cliente, nunca gravados aqui.
    // Soft-delete via ativo:false (arquivar).
    match /planos_acao/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- subtarefas ----------
    match /subtarefas/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- eventos (soft-delete por campo ativo) ----------
    match /eventos/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- kpi_snapshots (1 doc por dia, imutavel) ----------
    match /kpi_snapshots/{dia} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update, delete: if false;
    }

    // ---------- tudo o mais: NEGA ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
