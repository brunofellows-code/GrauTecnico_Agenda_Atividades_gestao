rules_version = '2';

// ============================================================
// Sistema A · Grau Técnico FSA — Regras do Firestore
// Fase 1 (base) + Bloco 2 (ocorrencias, solicitacoes)
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function meRef() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function meExists() {
      return signedIn() && exists(meRef());
    }
    function me() {
      return get(meRef()).data;
    }
    function isActive() {
      return meExists() && me().ativo == true;
    }
    function perfil() {
      return me().perfil;
    }
    function isAdmin() {
      // Transição 4->3 perfis (lockout-safe): aceita legado 'Admin' E o novo 'gestor'.
      return isActive() && (perfil() == 'Admin' || perfil() == 'gestor');
    }
    function canWrite() {
      // Transição 4->3 perfis: legados 'Admin'/'Editor' E novos 'gestor'/'lider'.
      return isActive() && (perfil() == 'Admin' || perfil() == 'Editor'
                            || perfil() == 'gestor' || perfil() == 'lider');
    }
    function isLider() {
      // F1-D: líder precisa LISTAR usuários para atribuir responsável aos
      // liderados. O recorte fino (só o escopo dele) é aplicado no cliente
      // via KPI.usuariosNoEscopo — a rule dá o piso (nome/perfil/setor de
      // usuários ativos; nada sensível além do que a sidebar já mostra).
      return isActive() && (perfil() == 'lider' || perfil() == 'Editor');
    }
    function donoAtividade(aid) {
      return signedIn()
          && exists(/databases/$(database)/documents/atividades/$(aid))
          && get(/databases/$(database)/documents/atividades/$(aid)).data.criadoPor == request.auth.uid;
    }

    // ---------- usuarios (RBAC) ----------
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin() || isLider(); // F1-D: líder lista para atribuir no escopo
      allow write: if isAdmin();
    }

    // ---------- setores ----------
    match /setores/{sigla} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- projetos ----------
    match /projetos/{id} {
      allow read: if isActive();
      allow write: if canWrite();
    }

    // ---------- atividades ----------
    match /atividades/{id} {
      allow read: if isActive();
      allow write: if canWrite();
    }

    // ---------- ocorrencias ----------
    match /ocorrencias/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- solicitacoes ----------
    match /solicitacoes/{id} {
      allow read: if isActive();
      allow create: if canWrite()
                    && request.resource.data.solicitanteUid == request.auth.uid
                    && request.resource.data.status == 'pendente';
      allow update: if isAdmin() || donoAtividade(resource.data.atividadeId);
      allow delete: if false;
    }

    // ---------- atividade_log (append-only) ----------
    match /atividade_log/{id} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update, delete: if false;
    }

    // ---------- reunioes (PRÉ-PROVISIONADO p/ C2 — a tela chega na C2; bloco inofensivo) ----------
    match /reunioes/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- subtarefas (PRÉ-PROVISIONADO p/ C2 — a tela chega na C2; bloco inofensivo) ----------
    match /subtarefas/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- eventos (agenda de eventos — N4-B; soft-delete por `ativo`) ----------
    match /eventos/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- kpi_snapshots (foto diária dos indicadores; 1 doc/dia, imutável) ----------
    match /kpi_snapshots/{dia} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update, delete: if false;
    }

    // ---------- tudo o mais: NEGA ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
