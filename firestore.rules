rules_version = '2';

// ============================================================
// Sistema A - Grau Tecnico FSA - Regras do Firestore
// Fase 1 (base) + Bloco 2 (ocorrencias, solicitacoes) + F1-D
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function meRef() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function meExists() {
      return signedIn() && exists(meRef());
    }

    function me() {
      return get(meRef()).data;
    }

    function isActive() {
      return meExists() && me().ativo == true;
    }

    function perfil() {
      return me().perfil;
    }

    // Transicao 4->3 perfis (lockout-safe): aceita legado 'Admin' e o novo 'gestor'.
    function isAdmin() {
      return isActive() && (perfil() == 'Admin' || perfil() == 'gestor');
    }

    // Transicao 4->3 perfis: legados 'Admin'/'Editor' e novos 'gestor'/'lider'.
    function canWrite() {
      return isActive() && (perfil() == 'Admin' || perfil() == 'Editor'
                            || perfil() == 'gestor' || perfil() == 'lider');
    }

    // F1-D: o lider precisa LISTAR usuarios para atribuir responsavel aos
    // liderados. O recorte fino (somente o escopo dele) e aplicado no cliente
    // via KPI.usuariosNoEscopo. Esta regra da o piso: nome/perfil/setor de
    // usuarios ativos, nada alem do que a sidebar ja mostra.
    function isLider() {
      return isActive() && (perfil() == 'lider' || perfil() == 'Editor');
    }

    function donoAtividade(aid) {
      return signedIn()
          && exists(/databases/$(database)/documents/atividades/$(aid))
          && get(/databases/$(database)/documents/atividades/$(aid)).data.criadoPor == request.auth.uid;
    }

    // ---------- usuarios (RBAC) ----------
    // F1-D: 'list' liberado para gestor E lider (o lider atribui no escopo).
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin() || isLider();
      allow write: if isAdmin();
    }

    // ---------- setores ----------
    match /setores/{sigla} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- projetos ----------
    match /projetos/{id} {
      allow read: if isActive();
      allow write: if canWrite();
    }

    // ---------- atividades ----------
    match /atividades/{id} {
      allow read: if isActive();
      allow write: if canWrite();
    }

    // ---------- ocorrencias ----------
    match /ocorrencias/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- solicitacoes ----------
    match /solicitacoes/{id} {
      allow read: if isActive();
      allow create: if canWrite()
                    && request.resource.data.solicitanteUid == request.auth.uid
                    && request.resource.data.status == 'pendente';
      allow update: if isAdmin() || donoAtividade(resource.data.atividadeId);
      allow delete: if false;
    }

    // ---------- atividade_log (append-only) ----------
    match /atividade_log/{id} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update, delete: if false;
    }

    // ---------- reunioes ----------
    match /reunioes/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- subtarefas ----------
    match /subtarefas/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- eventos (soft-delete por campo ativo) ----------
    match /eventos/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- kpi_snapshots (1 doc por dia, imutavel) ----------
    match /kpi_snapshots/{dia} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update, delete: if false;
    }

    // ---------- tudo o mais: NEGA ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
