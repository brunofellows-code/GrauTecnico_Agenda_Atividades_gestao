rules_version = '2';

// ============================================================
// Sistema A - Grau Tecnico FSA - Regras do Firestore
// Fase 1 (base) + Bloco 2 (ocorrencias, solicitacoes) + F1-D
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function meRef() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function meExists() {
      return signedIn() && exists(meRef());
    }

    function me() {
      return get(meRef()).data;
    }

    function isActive() {
      return meExists() && me().ativo == true;
    }

    function perfil() {
      return me().perfil;
    }

    // Transicao 4->3 perfis (lockout-safe): aceita legado 'Admin' e o novo 'gestor'.
    function isAdmin() {
      return isActive() && (perfil() == 'Admin' || perfil() == 'gestor');
    }

    // Transicao 4->3 perfis: legados 'Admin'/'Editor' e novos 'gestor'/'lider'.
    function canWrite() {
      return isActive() && (perfil() == 'Admin' || perfil() == 'Editor'
                            || perfil() == 'gestor' || perfil() == 'lider');
    }

    // F1-D: o lider precisa LISTAR usuarios para atribuir responsavel aos
    // liderados. O recorte fino (somente o escopo dele) e aplicado no cliente
    // via KPI.usuariosNoEscopo. Esta regra da o piso: nome/perfil/setor de
    // usuarios ativos, nada alem do que a sidebar ja mostra.
    function isLider() {
      return isActive() && (perfil() == 'lider' || perfil() == 'Editor');
    }

    // R8 - ALCADA DO PLANEJAMENTO NAS REGRAS (nao so no navegador).
    // socio = gestor com o marcador socio:true no cadastro (mesma definicao do
    // guard.js: perfil 'gestor' + data.socio === true). E ele - e so ele - que
    // assina a ciencia de SOCIO do plano.
    function souSocio() {
      return isActive() && perfil() == 'gestor' && me().get('socio', false) == true;
    }

    // Siglas que o lider lidera (lista do proprio cadastro). get(...,[]) evita
    // erro de campo ausente, que em rules significa NEGAR tudo em silencio.
    function meusSetores() {
      return me().get('setoresLiderados', []);
    }

    // Raiz do setor: lider de setor RAIZ cobre os subsetores dele - a mesma
    // regra que o KPI.escopoLider aplica no cliente. String vazia quando o
    // setor nao existe ou nao tem pai.
    function setorPaiDe(sig) {
      return exists(/databases/$(database)/documents/setores/$(sig))
             ? get(/databases/$(database)/documents/setores/$(sig)).data.get('setorPaiSigla', '')
             : '';
    }

    function noEscopoDoLider(sig) {
      return (sig in meusSetores())
          || (setorPaiDe(sig) != '' && setorPaiDe(sig) in meusSetores());
    }

    // R9-B (06/08) - TRAVA ("Travei nesta"). O impedimento e uma BANDEIRA, nao
    // um status: a tarefa continua no status que estava e continua contando no
    // atraso (padrao Jira Impediment). Por isso a validacao mora FORA do
    // 'status in [...]' - travar nao pode ser jeito de sumir com a cobranca.
    // Motivo e LISTA FECHADA: e ele que vira estatistica para o lider. Valor
    // livre no banco = Pareto sujo. '' = destravado (null sumiria do 'in').
    function travaValida() {
      return (!('travadoMotivo' in request.resource.data)
              || request.resource.data.travadoMotivo in
                 ['', 'dependencia', 'informacao', 'prioridade', 'tempo', 'ferramenta', 'outro'])
          && (!('travadoDetalhe' in request.resource.data)
              || (request.resource.data.travadoDetalhe is string
                  && request.resource.data.travadoDetalhe.size() <= 280));
    }

    function donoAtividade(aid) {
      return signedIn()
          && exists(/databases/$(database)/documents/atividades/$(aid))
          && get(/databases/$(database)/documents/atividades/$(aid)).data.criadoPor == request.auth.uid;
    }

    // ---------- usuarios (RBAC) ----------
    // F1-D: 'list' liberado para gestor E lider (o lider atribui no escopo).
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin() || isLider();
      allow write: if isAdmin();
    }

    // ---------- setores ----------
    match /setores/{sigla} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- projetos (LEGADO — R4-B2) ----------
    // "Projeto" nao existe mais: nenhuma tela escreve aqui. A leitura
    // fica SO para o admin, porque o backup do gestor (importacao.html,
    // BK_COLS) percorre a colecao em cadeia sem catch por colecao —
    // negar a leitura derrubaria o backup inteiro. Escrita: morta.
    match /projetos/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- planejamentos (R4-B3: plano mensal do setor) ----------
    // Plano mensal do lider - O que / Como / Quem / Quando / Quanto
    // (NAO e 5W2H: a tela nunca coletou Onde nem Por que - nome corrigido na R8).
    // 1 doc por setor+competencia. Leitura ABERTA a todo ativo
    // (prestacao de contas publica - RESUMO §4).
    //
    // R8 - AS REGRAS PASSAM A IMPOR A ALCADA (antes: 'allow update: if canWrite()').
    // O modelo antigo descrito aqui ("item >R$200 exige aprovLider E aprovGestor")
    // ja estava MORTO desde a R4-EXT: aprovLider saiu do modelo e quem assina e
    // GESTOR + SOCIO. Pior: sem restricao de campo nem de setor, QUALQUER lider
    // ativo gravava aprovGestor, aprovSocio, entregueEm e dispensas de QUALQUER
    // setor - toda a governanca era convencao de navegador, derrubavel com o
    // console aberto. Agora:
    //   - conteudo do plano (itens, dispensas, entregueEm): gestor em qualquer
    //     setor; lider SOMENTE no setor que ele lidera (raiz cobre subsetor).
    //   - ciencia do PLANO: aprovGestor so por gestor; aprovSocio SO por socio.
    //     Nenhum lider toca nesses dois campos, em setor nenhum.
    //   - setorSigla, competencia, criadoPor, criadoEm: imutaveis (ficam fora
    //     do hasOnly, entao qualquer tentativa de mexer neles nega o update).
    // LIMITE HONESTO E DECLARADO: rules nao enxergam DENTRO de array, entao a
    // alcada por ITEM (o >R$200 e o four-eyes de quem criou o item) continua
    // aplicada no cliente e auditada no atividade_log. O que subiu para o
    // servidor foi o que da para modelar sem explodir o doc: quem escreve, em
    // qual setor e em quais campos.
    function planoMudou() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function planoSoConteudo() {
      return planoMudou().hasOnly(['itens', 'dispensas', 'entregueEm', 'atualizadoEm']);
    }
    function planoSoCienciaGestor() {
      return planoMudou().hasOnly(['aprovGestor', 'atualizadoEm']);
    }
    function planoSoCienciaSocio() {
      return planoMudou().hasOnly(['aprovSocio', 'atualizadoEm']);
    }
    // O update trancou os dois campos de ciencia - mas o CREATE nao tinha
    // restricao de campo nenhuma, e create tambem grava. Um lider podia
    // addDoc() um planejamento JA NASCENDO com aprovGestor/aprovSocio
    // preenchidos e o plano aparecia "Aprovado" sem gestor nem socio terem
    // aberto a tela: a trava do update viraria enfeite, contornavel criando
    // o doc do jeito certo na primeira gravacao. O plano nasce SEM ciencia.
    function planoNasceSemCiencia() {
      return !request.resource.data.keys().hasAny(['aprovGestor', 'aprovSocio']);
    }
    match /planejamentos/{id} {
      allow read: if isActive();
      // criadoPor e a base do four-eyes do plano: tem de ser o autor autenticado.
      // setorSigla/competencia sao a identidade do doc (1 plano por setor+mes):
      // exigidos no nascimento, e imutaveis depois (ficam fora dos hasOnly).
      allow create: if (isAdmin() || (isLider() && noEscopoDoLider(request.resource.data.setorSigla)))
                    && request.resource.data.criadoPor == request.auth.uid
                    && request.resource.data.setorSigla is string
                    && request.resource.data.competencia is string
                    && request.resource.data.competencia.size() == 7
                    && planoNasceSemCiencia();
      allow update: if (planoSoConteudo()
                        && (isAdmin() || (isLider() && noEscopoDoLider(resource.data.setorSigla))))
                    || (planoSoCienciaGestor() && isAdmin())
                    || (planoSoCienciaSocio() && souSocio());
      allow delete: if false; // soft-delete sempre (ativo:false)
    }

    // ---------- atividades ----------
    // R5-B1: ACEITE DE ATRIBUICAO (padrao Outlook Accept/Decline em tarefa
    // atribuida): o RESPONSAVEL — mesmo perfil 'usuario' — registra aceite ou
    // recusa na PROPRIA atividade. Espelha o F1-J das ocorrencias: o vinculo
    // e verificado no doc atual (resource), e o diff trava tudo alem dos
    // campos do aceite. Delete explicito negado (soft-delete sempre; nenhuma
    // tela chama deleteDoc — verificado no repo em 22/07).
    match /atividades/{id} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update: if canWrite()
        || (isActive()
            && resource.data.responsavelUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aceite', 'recusaAtribuicao', 'atualizadoEm']));
      allow delete: if false;
    }

    // ---------- ocorrencias ----------
    match /ocorrencias/{id} {
      allow read: if isActive();
      // F1-J: o RESPONSÁVEL age nas PRÓPRIAS ocorrências (padrão Asana:
      // quem é assignado numa tarefa pode concluí-la mesmo sendo
      // comment-only no resto). Só status de EXECUÇÃO — reprogramar e
      // pular continuam exigindo líder/gestor. O vínculo é verificado na
      // ATIVIDADE-mãe (1 get), não no que o cliente declara.
      // R9-B: o "|| !('status' in ...)" nasceu com a TRAVA. Uma ocorrencia sem
      // doc nenhum e 'pendente' por DERIVACAO (recorrencia.js:261) - travar a
      // primeira vez cria o doc so com a bandeira, sem status. Doc sem status
      // = status derivado, exatamente o que ja era. Nao ha o que fraudar.
      allow create: if canWrite()
        || (isActive()
            && get(/databases/$(database)/documents/atividades/$(request.resource.data.atividadeId)).data.responsavelUid == request.auth.uid
            && travaValida()
            && (request.resource.data.status in ['concluida', 'pendente', 'em_andamento']
                || !('status' in request.resource.data)));
      allow update: if canWrite()
        || (isActive()
            && get(/databases/$(database)/documents/atividades/$(request.resource.data.atividadeId)).data.responsavelUid == request.auth.uid
            && travaValida()
            // R9-B: a trava NAO muda status - entao quando 'status' nao esta
            // entre as chaves afetadas, nao ha status para julgar. Sem este
            // ramo, travar uma ocorrencia 'reprogramada' seria negado: o
            // status dela (inalterado) nao esta na lista de execucao.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                || request.resource.data.status in ['concluida', 'pendente', 'em_andamento'])
            // edge da reatribuição: a base denormalizada (responsavelUid/
            // setorSigla) pode ressincronizar com a atividade-mãe — mas SÓ
            // para os valores atuais dela (nunca valores livres). data/
            // prazoOriginal/atividadeId ficam FORA: são amarrados ao id do
            // doc e mudar 'data' moveria o effDate (fraude de prazo).
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'concluidaEm', 'iniciadaEm', 'responsavelUid', 'setorSigla', 'travadoMotivo', 'travadoDetalhe', 'travadoEm'])
            && request.resource.data.responsavelUid == request.auth.uid
            && request.resource.data.setorSigla == get(/databases/$(database)/documents/atividades/$(request.resource.data.atividadeId)).data.setorSigla);
      allow delete: if false;
    }

    // ---------- solicitacoes ----------
    // R7·B2.6 (27/07): create aberto a QUALQUER usuario ativo (era canWrite).
    // Motivo: o responsavel comum agora tem "Adiar" no Hoje — ele nao pode
    // reprogramar (F1-J), entao cria um PEDIDO para o dono aprovar. Mesmo
    // anti-spoof de sempre: solicitanteUid TEM de ser o autor autenticado e
    // o doc nasce 'pendente'. Aprovar/negar continua com admin/dono.
    match /solicitacoes/{id} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.solicitanteUid == request.auth.uid
                    && request.resource.data.status == 'pendente';
      allow update: if isAdmin() || donoAtividade(resource.data.atividadeId);
      allow delete: if false;
    }

    // ---------- atividade_log (append-only) ----------
    // F1-G: create aberto a QUALQUER usuario ativo. O perfil 'usuario' agora
    // grava item de pauta (D2) e a mutacao dele tambem precisa ser logada —
    // append-only + update/delete negados: abrir o create e MAIS auditoria.
    match /atividade_log/{id} {
      allow read: if isActive();
      // RAIO-X: o uid gravado TEM de ser o do autor autenticado — impede
      // forjar autoria (o ranking da Performance nasce deste log).
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- reunioes ----------
    // F1-G (D2): participante (perfil 'usuario') pode mexer SO em pautaItens
    // (padrao Fellow: qualquer participante adiciona talking point). O diff
    // de chaves garante que nada alem da pauta e tocavel sem canWrite.
    // R5-B1: caminho RSVP do convocado — confirmadosUids (confirmar em 1
    // toque, F1-N) e recusas (avisar que nao vem, com motivo). O codigo do
    // Hoje ja gravava confirmadosUids desde a F1-N, mas a regra nunca subiu:
    // perfil 'usuario' tomava permission-denied. Mexer so no PROPRIO uid e
    // aplicado no cliente e auditado no atividade_log (anti-spoof uid==auth);
    // granularidade por chave de mapa nao e modelavel aqui sem explodir o doc
    // (mesma doutrina da alcada do planejamento, HANDOFF R4).
    match /reunioes/{id} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update: if canWrite()
                    || (isActive()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pautaItens', 'atualizadoEm']))
                    || (isActive()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmadosUids', 'recusas']));
      allow delete: if false;
    }

    // ---------- pauta_sugestoes (F1-F: cascata de pauta entre reunioes) ----------
    // Sugestao encaminhada de uma reuniao para a pauta de outra (tipo/setor).
    // Soft-delete via status 'descartada' (nunca delete fisico).
    // F1-G (D2): CREATE aberto a qualquer usuario ativo (todo participante
    // sugere pauta — padrao Fellow/Parabol). Moderacao (aceitar/descartar =
    // update) continua lider+.
    match /pauta_sugestoes/{id} {
      allow read: if isActive();
      allow create: if isActive();
      allow update: if canWrite();
      allow delete: if false;
    }

    // ---------- planos_acao (F1-G: plano vivo da Inteligencia) ----------
    // Plano nasce do gargalo/banda (ACAO OBRIGATORIA), tem dono, prazo e
    // atividadeIds[] (a execucao vive nas atividades — 1 motor). Status e
    // progresso sao SEMPRE derivados no cliente, nunca gravados aqui.
    // Soft-delete via ativo:false (arquivar).
    match /planos_acao/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- subtarefas ----------
    match /subtarefas/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- eventos (soft-delete por campo ativo) ----------
    match /eventos/{id} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // ---------- cockpit (lancamento dos indicadores de negocio) ----------
    // Substitui Cockpit_Diario_Gestor.xlsx. 1 doc POR PERIODO, e o id E o
    // periodo (d_AAAA-MM-DD | s_AAAA-Snn | m_AAAA-MM). Id = periodo torna o
    // lancamento idempotente: salvar de novo corrige, nunca duplica.
    //
    // ESCRITA SO DO GESTOR — e nao de canWrite(). Motivo: inadimplencia,
    // vendas, evasao e NPS sao os numeros que vao para o grupo dos socios e
    // para a reuniao estrategica. Quem lanca responde por eles. Lider tem
    // canWrite() no resto do sistema e mesmo assim NAO lanca aqui.
    //
    // Leitura aberta a qualquer ativo: o numero que vai ao grupo dos socios
    // nao e segredo dos socios; esconder resultado de quem executa e o
    // oposito do que a rotina pretende.
    //
    // Anti-forja: quem grava tem de assinar com o proprio uid (mesma
    // doutrina do atividade_log). Sem delete — historico de KPI nao se apaga;
    // corrigir e sobrescrever, e o atividade_log guarda quem mexeu e quando.
    match /cockpit/{periodo} {
      allow read: if isActive();
      allow create, update: if isAdmin()
                            && request.resource.data.atualizadoPorUid == request.auth.uid;
      allow delete: if false;
    }

    // ---------- kpi_snapshots (1 doc por dia, imutavel) ----------
    match /kpi_snapshots/{dia} {
      allow read: if isActive();
      allow create: if canWrite();
      allow update, delete: if false;
    }

    // ---------- tudo o mais: NEGA ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
